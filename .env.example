# Firebase Web App Configuration
# Copy this file to .env and fill in your values from:
# Firebase Console → Project Settings → Your Apps → Web App → Firebase SDK snippet → Config

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-Side Secure Google Gemini API Configuration
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
# IMPORTANT: Use GEMINI_API_KEY for server-side security so keys are NEVER exposed to client JS.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred Gemini Model (default: gemini-1.5-flash, options: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Legacy client fallback env key (supported for backward compatibility)
VITE_GEMINI_API_KEY=

